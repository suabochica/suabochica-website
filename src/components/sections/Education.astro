---
import Section from "@/components/Section.astro";
import ResumeEntry from "@/components/ResumeEntry.astro";
import { Text } from 'suabochica-design-system';

import { getI18N } from "@/i18n";
import { useTranslations, getLangFromUrl } from "i18n/utils";

const language = getLangFromUrl(Astro.url);
const translate = useTranslations(language);

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const { education } = i18n;
---

<Section title={translate(".education")}>
  <ul>
    {
      education.map(
        ({ score, area, description, institution, startDate, endDate }) => {
          return (
            <li>
              <ResumeEntry title={institution} detail={area} startDate={startDate} endDate={endDate}>
                {score && <Text variant="small" tone="muted">{score}</Text>}
                <Text>{description}</Text>
              </ResumeEntry>
            </li>
          );
        },
      )
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--sua-space-xl);
  }
</style>
