---
import 'suabochica-design-system/styles.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
const { currentLocale } = Astro;
---

<!doctype html>
<html lang={currentLocale} class="sua-theme" data-theme="system">
	<head>
		<script is:inline>
			let preference;
			try {
				preference = localStorage.getItem('theme-preference');
			} catch {
				// Private browsing may block storage; the system theme is the default.
			}
			if (preference === 'light' || preference === 'dark') {
				document.documentElement.dataset.theme = preference;
			}
		</script>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	html {
		font-family: var(--sua-font-body);
		background: var(--sua-canvas);
		color: var(--sua-text);
	}

	body,
	figure,
	ul {
		margin: 0;
		padding: 0;
	}

	ul {
		list-style: none;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	h1,
	h2,
	h3,
	h4 {
		margin: 0;
		font-family: var(--sua-font-heading);
	}

	p {
		color: var(--sua-text);
		font-size: var(--sua-text-body);
		line-height: var(--sua-leading-body);
		margin: 0;
		text-wrap: pretty;
	}

	.print {
		display: none;
	}

	@media print {
		@page {
			margin: 14mm;
		}

		:root.sua-theme {
			color-scheme: light;
			--sua-canvas: white;
			--sua-surface: white;
			--sua-surface-reading: white;
			--sua-text: black;
			--sua-text-muted: black;
			--sua-heading-h2-color: var(--sua-palette-coral-dark);
			--sua-heading-h3-color: var(--sua-palette-teal-dark);
			--sua-link: black;
			--sua-on-primary: black;
			--sua-action-primary: white;
			--sua-action-primary-hover: white;
			--sua-border: #777;
			--sua-border-strong: #777;
			--sua-border-control: #777;
		}

		body {
			background: white;
		}

		a {
			color: black;
			text-decoration: underline;
		}

		article,
		li {
			break-inside: avoid;
		}

		.sua-surface {
			box-shadow: none;
		}

		.print {
			display: block;
			color: var(--sua-text);
		}
	}
</style>
