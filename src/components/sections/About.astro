---
import Section from "@/components/Section.astro";
import { Text } from 'suabochica-design-system';

import { getI18N } from "@/i18n";
import { useTranslations, getLangFromUrl } from "i18n/utils";

const language = getLangFromUrl(Astro.url);
const translate = useTranslations(language);

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const { summary } = i18n.basics;
---

<Section title={translate(".about")}>
  {
    summary.split("\n\n").map((paragraph) => <Text className="paragraph">{paragraph}</Text>)
  }
</Section>

<style>
  .paragraph {
    margin-bottom: var(--sua-space-lg);
  }
  .paragraph:last-child {
    margin-bottom: 0;
  }
</style>
