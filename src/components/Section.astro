---
import { Heading } from 'suabochica-design-system';

const { title } = Astro.props;
---

<section>
  {title && <div class="section-title"><Heading level={2} size="lg">{title}</Heading></div>}
  <slot />
</section>

<style>
  section {
    max-width: var(--sua-reading);
    margin: 0 auto var(--sua-space-lg);
  }

  .section-title {
    margin-bottom: var(--sua-space-sm);
  }
  @media (min-width: 940px) {
    section {
      margin: 0 auto var(--sua-space-xl);
    }
  }
</style>
