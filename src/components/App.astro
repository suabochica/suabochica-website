---
import Layout from "@/layouts/Layout.astro";

import About from "@/components/sections/About.astro";
import Education from "@/components/sections/Education.astro";
import Experience from "@/components/sections/Experience.astro";
import Projects from "@/components/sections/Projects.astro";
import Diplomas from "@/components/sections/Diplomas.astro";
import Skills from "@/components/sections/Skills.astro";
import Hero from "@/components/Hero.astro";
import KeyboardManager from "@/components/KeyboardManager.astro";

import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const {name, label} = i18n.basics;
---

<Layout title=`${name} - ${label}.`>
	<a class="skip-link" href="#main-content">{currentLocale === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
	<main id="main-content">
		<Hero />
		<About />
		<Experience />
		<Education />
		<Projects />
		<Diplomas />
		<Skills />
	</main>

	<KeyboardManager />
</Layout>

<style>
	.skip-link {
		position: absolute;
		z-index: 2;
		top: var(--sua-space-sm);
		left: var(--sua-space-sm);
		padding: var(--sua-space-sm);
		background: var(--sua-surface);
		color: var(--sua-link);
		transform: translateY(-200%);
	}

	.skip-link:focus-visible {
		transform: none;
		outline: var(--sua-focus-width) solid var(--sua-focus);
		outline-offset: var(--sua-focus-offset);
	}

	@media (forced-colors: active) {
		.skip-link:focus-visible {
			outline-color: Highlight;
		}
	}

	main {
		background-color: var(--sua-canvas);
		padding: var(--sua-margin-mobile);
		margin: auto;
		width: 100%;
	}

	@media (min-width: 48rem) {
		main {
			padding: var(--sua-margin-tablet);
		}
	}

	@media (min-width: 75rem) {
		main {
			padding: var(--sua-margin-desktop);
		}
	}

	@media print {
		.skip-link {
			display: none;
		}

		main {
			padding: 0;
		}
	}
</style>
