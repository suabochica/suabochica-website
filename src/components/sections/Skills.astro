---
import Section from "@/components/Section.astro";
import { Badge } from 'suabochica-design-system';

import { getI18N } from "@/i18n";
import { useTranslations, getLangFromUrl } from "i18n/utils";

const language = getLangFromUrl(Astro.url);
const translate = useTranslations(language);

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const { skills } = i18n;
const levelLabels: Record<string, string> = currentLocale === 'en'
  ? { basic: 'Basic', intermediate: 'Intermediate', advanced: 'Advanced' }
  : { basic: 'Básico', intermediate: 'Intermedio', advanced: 'Avanzado' };
---

<Section title={translate(".skills")}>
  <p class="introduction" set:html={translate(".skills.description")} />
  <ul>
    {
      skills.map(({ name, level }) => (
        <li>
          <Badge tone="neutral">{name} · {levelLabels[level] ?? level}</Badge>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .introduction {
    margin-bottom: var(--sua-space-lg);
  }

  ul {
    display: inline-flex;
    gap: var(--sua-space-sm);
    flex-wrap: wrap;
  }

  li {
    max-width: 100%;
  }
</style>
