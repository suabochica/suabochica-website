---
import Section from "@/components/Section.astro";
import { Figure, Heading, Surface, Text, TextLink } from 'suabochica-design-system';

import { getI18N } from "@/i18n";
import { useTranslations, getLangFromUrl } from "i18n/utils";

const language = getLangFromUrl(Astro.url);
const translate = useTranslations(language);

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const { diplomas } = i18n;
---

<Section title={translate(".diplomas")}>
  <ul>
    {
      diplomas.map((diploma) => (
        <li>
          <Surface as="article" tone="paper" radius="card" padding="md" className="credential">
            <Heading level={3} size="sm">{diploma.name}</Heading>
            <Text variant="small" tone="muted">{diploma.issuer}</Text>
            <time datetime={diploma.date}>{diploma.date}</time>
            <Figure
              image={{ src: diploma.image, alt: `${diploma.name} — ${diploma.issuer}`, width: 220, height: 160, loading: 'lazy' }}
            />
            <TextLink href={diploma.url} target="_blank" rel="noopener noreferrer">
              {currentLocale === 'en' ? 'View certificate' : 'Ver certificado'}: {diploma.name}
            </TextLink>
          </Surface>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--sua-space-md);
  }

  li {
    min-width: 0;
  }

  .credential {
    display: flex;
    flex-direction: column;
    gap: var(--sua-space-sm);
    height: 100%;
  }

  time {
    color: var(--sua-text-muted);
    font-size: var(--sua-text-small);
  }

  .credential :global(.sua-figure__image) {
    display: block;
    width: 100%;
    height: 10rem;
    object-fit: contain;
  }

  @media print {
    .credential :global(.sua-figure__image) {
      height: 5rem;
    }
  }
</style>
