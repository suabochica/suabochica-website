---
const { currentLocale } = Astro;
const isEnglish = currentLocale === 'en';
---

<div class="theme-control">
  <label for="theme-preference">{isEnglish ? 'Theme' : 'Tema'}</label>
  <select id="theme-preference" name="theme-preference">
    <option value="system">{isEnglish ? 'System' : 'Sistema'}</option>
    <option value="light">{isEnglish ? 'Light' : 'Claro'}</option>
    <option value="dark">{isEnglish ? 'Dark' : 'Oscuro'}</option>
  </select>
</div>

<script>
  type Theme = 'light' | 'dark' | 'system';
  const STORAGE_KEY = 'theme-preference';
  const select = document.querySelector<HTMLSelectElement>('#theme-preference');

  function readPreference(): Theme {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored === 'light' || stored === 'dark' || stored === 'system') {
        return stored;
      }
    } catch {
      // Keep the system preference when storage is unavailable.
    }
    return 'system';
  }

  function applyPreference(preference: Theme) {
    document.documentElement.dataset.theme = preference;
    if (select) select.value = preference;
  }

  applyPreference(readPreference());

  select?.addEventListener('change', () => {
    const preference = select.value as Theme;
    applyPreference(preference);
    try {
      localStorage.setItem(STORAGE_KEY, preference);
    } catch {
      // The selected theme still works for this page.
    }
  });

  window.addEventListener('storage', (event) => {
    if (event.key === STORAGE_KEY || event.key === null) {
      applyPreference(readPreference());
    }
  });
</script>

<style>
  .theme-control {
    display: inline-flex;
    align-items: center;
    gap: var(--sua-space-xs);
    color: var(--sua-text);
    font-family: var(--sua-font-heading);
    font-size: var(--sua-text-small);
  }

  select {
    background: var(--sua-surface);
    border: 1px solid var(--sua-border-control);
    border-radius: var(--sua-radius-control);
    color: var(--sua-text);
    font: inherit;
    min-height: 2.75rem;
    padding: var(--sua-space-xs);
    cursor: pointer;
  }

  select:focus-visible {
    outline: var(--sua-focus-width) solid var(--sua-focus);
    outline-offset: var(--sua-focus-offset);
  }

  @media (forced-colors: active) {
    select {
      border-color: ButtonText;
    }

    select:focus-visible {
      outline-color: Highlight;
    }
  }
</style>
