---
import Section from "@/components/Section.astro";
import ResumeEntry from "@/components/ResumeEntry.astro";
import { Text } from 'suabochica-design-system';

import { getI18N } from "@/i18n";
import { useTranslations, getLangFromUrl } from "i18n/utils";

const language = getLangFromUrl(Astro.url);
const translate = useTranslations(language);

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const { work } = i18n;
---

<Section title={translate(".work")}>
  <ul>
    {
      work.map(({ name, startDate, endDate, position, summary }) => {
        return (
          <li>
            <ResumeEntry title={name} detail={position} startDate={startDate} endDate={endDate}>
              <Text>{summary}</Text>
            </ResumeEntry>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--sua-space-xl);
  }
</style>
