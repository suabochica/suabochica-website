---
import Section from "@/components/Section.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import {
  Button,
  Figure,
  Heading,
  Icon,
  Text,
  type IconName,
} from 'suabochica-design-system';

import MapPin from "@/components/icons/MapPin.astro";

import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const {
  name,
  label,
  location,
  email,
  emailTitle,
  blog,
  blogTitle,
  cv,
  cvTitle,
  phone,
  phoneTitle,
  image,
  profiles,
} = i18n.basics;
const { city, region } = location;

const SOCIAL_ICONS: Record<string, IconName> = {
  LinkedIn: "linkedin",
  GitHub: "github",
  Instagram: "instagram",
  X: "x",
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ");
---

<Section>
  <div class="container">
    <div class="info">
      <Heading level={1} size="xl">{name}</Heading>
      <Text variant="lead">{label}</Text>
      <div class="location">
        <MapPin />
        <Text as="span" variant="small" tone="muted">{city}, {region}</Text>
      </div>
      <footer>
        <div class="print">
          {printInfo}
        </div>
        {
          email && (
            <a
              href={`mailto:${email}`}
              aria-label={`${emailTitle} ${name}`}
            >
              <Icon name="mail-out" />
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              aria-label={`${phoneTitle} ${phone}`}
            >
              <Icon name="phone-income" />
            </a>
          )
        }
        {
          blog && (
            <a
              href={`${blog}`}
              aria-label={`${blogTitle}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="post" />
            </a>
          )
        }
        {
          cv && (
            <a
              href={`${cv}`}
              aria-label={`${cvTitle}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="page-star" />
            </a>
          )
        }
        {
          profiles.map(({ network, url, title }) => (
            <a
              href={url}
              aria-label={`${title} ${network}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={SOCIAL_ICONS[network]} />
            </a>
          ))
        }
        {
          currentLocale === "es" ? (
            <a
              href={`/en`}
              aria-label="Perfil en inglés"
              lang="en"
            >
              EN
            </a>
          ) : (
            <a
              href={`/`}
              aria-label="Profile in Spanish"
              lang="es"
            >
              ES
            </a>
          )
        }
        <div class="preferences">
          <Button id="open-commands" type="button" variant="outline" size="small" aria-controls="command-palette">
            {currentLocale === 'en' ? 'Commands' : 'Comandos'}
          </Button>
          <ThemeSwitch />
        </div>
      </footer>
    </div>
    <div class="portrait">
      <Figure image={{ src: image, alt: name, width: 1024, height: 1024, loading: 'eager' }} />
    </div>
  </div>
</Section>

<style>
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    justify-content: center;
  }

  .portrait {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
  }

  .portrait :global(img) {
    display: block;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 100px;
    height: 100px;
    border-radius: var(--sua-radius-card);
  }

  .location {
    display: flex;
    align-items: center;
    gap: var(--sua-space-xs);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sua-space-xs);
    margin-top: 8px;
  }

  .preferences {
    display: flex;
    align-items: center;
    gap: var(--sua-space-xs);
  }

  .preferences :global(.theme-control) {
    display: inline-flex;
    align-items: center;
  }

  .preferences :global(#open-commands),
  .preferences :global(.sua-dropdown__trigger),
  .preferences :global(.sua-dropdown__fallback) {
    box-sizing: border-box;
    block-size: 44px;
    min-block-size: 44px;
    padding-block: 0;
  }

  .preferences :global(.sua-dropdown__label) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  footer a {
    position: relative;
    color: var(--sua-link);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--sua-border-control);
    padding: 4px;
    height: 2.75rem;
    width: 2.75rem;
    border-radius: var(--sua-radius-control);
    transition: background-color var(--sua-motion-duration) ease;
  }

  footer a::after {
    content: attr(aria-label);
    position: absolute;
    z-index: 1;
    bottom: calc(100% + var(--sua-space-xs));
    left: 0;
    width: max-content;
    max-width: min(18rem, 70vw);
    padding: var(--sua-space-xs) var(--sua-space-sm);
    background: var(--sua-surface);
    color: var(--sua-text);
    border: 1px solid var(--sua-border-strong);
    border-radius: var(--sua-radius-control);
    box-shadow: var(--sua-shadow-card);
    font-family: var(--sua-font-body);
    font-size: var(--sua-text-small);
    line-height: var(--sua-leading-small);
    text-align: left;
    text-wrap: pretty;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--sua-motion-duration) ease,
      visibility var(--sua-motion-duration) step-end;
  }

  footer a:hover::after,
  footer a:focus-visible::after {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--sua-motion-duration) ease,
      visibility 0s step-start;
  }

  footer a:hover {
    background: var(--sua-surface);
    border-color: var(--sua-border-strong);
  }

  footer a:focus-visible {
    outline: var(--sua-focus-width) solid var(--sua-focus);
    outline-offset: var(--sua-focus-offset);
  }

  @media (prefers-reduced-motion: reduce) {
    footer a::after {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    footer a {
      border-color: ButtonText;
    }

    footer a:focus-visible {
      outline-color: Highlight;
    }

    footer a::after {
      background: Canvas;
      color: CanvasText;
      border: 1px solid CanvasText;
    }
  }

  @media print {
    .preferences,
    .portrait,
    footer a,
    footer :global(.sua-button),
    footer :global(.theme-control) {
      display: none;
    }

    footer {
      margin-top: var(--sua-space-sm);
    }
  }

  @media (min-width: 940px) {
    .container {
      align-items: center;
      flex-direction: row;
      justify-content: space-between;
      gap: 1rem;

    }

    .info {
      padding-right: 0;
      align-items: start;
    }
  }
</style>
