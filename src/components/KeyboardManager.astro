---
import { getI18N } from '@/i18n';

import githubSvg from 'suabochica-design-system/icons/github.svg?raw';
import linkedinSvg from 'suabochica-design-system/icons/linkedin.svg?raw';
import xSvg from 'suabochica-design-system/icons/x.svg?raw';
import instagramSvg from 'suabochica-design-system/icons/instagram.svg?raw';
import postSvg from 'suabochica-design-system/icons/post.svg?raw';
import pageStarSvg from 'suabochica-design-system/icons/page-star.svg?raw';

const { currentLocale } = Astro;
const isEnglish = currentLocale === 'en';
const { profiles, blog, blogTitle, cv, cvTitle } = getI18N({ currentLocale }).basics;

const paletteIcon = (svg: string) =>
  svg
    .replace('width="24"', 'width="16"')
    .replace('height="24"', 'height="16"')
    .replace('<svg ', '<svg class="ninja-icon" ');

const PROFILE_ICONS: Record<string, string> = {
  GitHub: githubSvg,
  LinkedIn: linkedinSvg,
  X: xSvg,
  Instagram: instagramSvg,
};

const profilesInfo = profiles.map(({ network, url, title }) => ({
  id: network,
  section: isEnglish ? 'Links' : 'Enlaces',
  title: `${title} ${network}`,
  url,
  icon: PROFILE_ICONS[network] ? paletteIcon(PROFILE_ICONS[network]) : undefined,
}));

const linkInfo = [
  blog && { id: 'blog', section: isEnglish ? 'Links' : 'Enlaces', title: blogTitle, url: blog, icon: paletteIcon(postSvg) },
  cv && { id: 'cv', section: isEnglish ? 'Links' : 'Enlaces', title: cvTitle, url: cv, icon: paletteIcon(pageStarSvg) },
  ...profilesInfo,
].filter(Boolean);
---

<p class="shortcut-hint">
  {isEnglish ? 'Open commands with' : 'Abre los comandos con'}
  <kbd>⌘</kbd>/<kbd>Ctrl</kbd> + <kbd>K</kbd>
</p>

<ninja-keys
  id="command-palette"
  data-info={JSON.stringify(linkInfo)}
  data-locale={isEnglish ? 'en' : 'es'}
  placeholder={isEnglish ? 'Search commands' : 'Buscar comandos'}
  noautoloadmdicons
></ninja-keys>

<script>
  import "ninja-keys";

  const ninja = document.querySelector("ninja-keys");

  if (ninja != null) {
    const isEnglish = ninja.dataset.locale === 'en';
    const links = JSON.parse(ninja.dataset.info ?? '[]') as Array<{
      id: string;
      section: string;
      title: string;
      url: string;
      icon?: string;
    }>;

    ninja.data = [
      {
        id: "print",
        title: isEnglish ? 'Print page' : 'Imprimir página',
        section: isEnglish ? 'Actions' : 'Acciones',
        handler: () => {
          window.print();
        },
      },
      {
        id: isEnglish ? 'es' : 'en',
        title: isEnglish ? 'Profile in Spanish' : 'Perfil en inglés',
        section: isEnglish ? 'Actions' : 'Acciones',
        handler: () => {
          window.location.assign(isEnglish ? '/' : '/en');
        },
      },
      ...links.map((link) => ({
        ...link,
        handler: () => window.open(link.url, '_blank', 'noopener,noreferrer'),
      })),
    ];

    const trigger = document.querySelector<HTMLButtonElement>('#open-commands');
    trigger?.addEventListener('click', () => ninja.open());
  }
</script>

<style>
  ninja-keys {
    --ninja-font-family: var(--sua-font-body);
    --ninja-font-size: var(--sua-text-body);
    --ninja-key-border-radius: var(--sua-radius-control);
    --ninja-overflow-background: color-mix(in srgb, var(--sua-canvas) 70%, transparent);
    --ninja-text-color: var(--sua-text);
    --ninja-secondary-text-color: var(--sua-text-muted);
    --ninja-group-text-color: var(--sua-text-muted);
    --ninja-placeholder-color: var(--sua-placeholder);
    --ninja-accent-color: var(--sua-focus);
    --ninja-icon-color: var(--sua-text);
    --ninja-modal-background: var(--sua-surface);
    --ninja-modal-shadow: var(--sua-shadow-overlay);
    --ninja-secondary-background-color: var(--sua-canvas);
    --ninja-selected-background: var(--sua-surface-reading);
    --ninja-selected-text-color: var(--sua-text);
    --ninja-footer-background: var(--sua-canvas);
    --ninja-separate-border: 1px solid var(--sua-border);
  }

  ninja-keys::part(ninja-input):focus-visible {
    outline: var(--sua-focus-width) solid var(--sua-focus);
    outline-offset: calc(-1 * var(--sua-focus-width));
  }

  .shortcut-hint {
    padding: var(--sua-space-md);
    color: var(--sua-text-muted);
    background: var(--sua-surface);
    border-top: 1px solid var(--sua-border);
    font-size: var(--sua-text-small);
    text-align: center;
  }

  kbd {
    background: var(--sua-canvas);
    border: 1px solid var(--sua-border);
    border-radius: var(--sua-radius-control);
    padding: var(--sua-space-xs);
  }

  @media (forced-colors: active) {
    ninja-keys {
      --ninja-text-color: CanvasText;
      --ninja-secondary-text-color: CanvasText;
      --ninja-selected-text-color: HighlightText;
      --ninja-selected-background: Highlight;
      --ninja-modal-background: Canvas;
      --ninja-secondary-background-color: Canvas;
      --ninja-accent-color: Highlight;
      --ninja-separate-border: 1px solid CanvasText;
    }

    ninja-keys::part(ninja-input):focus-visible {
      outline-color: Highlight;
    }
  }

  @media print {
    ninja-keys,
    .shortcut-hint {
      display: none;
    }
  }
</style>
