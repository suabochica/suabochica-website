---
import Section from "@/components/Section.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import { Button, Figure, Heading, Text } from 'suabochica-design-system';

import Mail from "@/components/icons/Mail.astro";
import Phone from "@/components/icons/Phone.astro";
import Book from "@/components/icons/Book.astro";
import File from "@/components/icons/File.astro";
import LinkedIn from "@/components/icons/LinkedIn.astro";
import GitHub from "@/components/icons/GitHub.astro";
import MapPin from "@/components/icons/MapPin.astro";
import X from "@/components/icons/X.astro";
import Instagram from "./icons/Instagram.astro";

import type { SocialIcon } from "@/types";

import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const {
  name,
  label,
  location,
  email,
  emailTitle,
  blog,
  blogTitle,
  cv,
  cvTitle,
  phone,
  phoneTitle,
  image,
  profiles,
} = i18n.basics;
const { city, region } = location;

const SOCIAL_ICONS: SocialIcon = {
  LinkedIn,
  GitHub,
  Instagram,
  X,
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ");
---

<Section>
  <div class="container">
    <div class="info">
      <Heading level={1} size="xl">{name}</Heading>
      <Text variant="lead">{label}</Text>
      <div class="location">
        <MapPin />
        <Text as="span" variant="small" tone="muted">{city}, {region}</Text>
      </div>
      <footer>
        <div class="print">
          {printInfo}
        </div>
        {
          email && (
            <a
              href={`mailto:${email}`}
              aria-label={`${emailTitle} ${name}`}
            >
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              aria-label={`${phoneTitle} ${phone}`}
            >
              <Phone />
            </a>
          )
        }
        {
          blog && (
            <a
              href={`${blog}`}
              aria-label={`${blogTitle}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Book />
            </a>
          )
        }
        {
          cv && (
            <a
              href={`${cv}`}
              aria-label={`${cvTitle}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <File />
            </a>
          )
        }
        {
          profiles.map(({ network, url, title }) => {
            const Icon = SOCIAL_ICONS[network];

            return (
              <a
                href={url}
                aria-label={`${title} ${network}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon />
              </a>
            );
          })
        }
        {
          currentLocale === "es" ? (
            <a
              href={`/en`}
              aria-label="Perfil en inglés"
              lang="en"
            >
              EN
            </a>
          ) : (
            <a
              href={`/`}
              aria-label="Profile in Spanish"
              lang="es"
            >
              ES
            </a>
          )
        }
        <Button id="open-commands" type="button" variant="outline" size="small" aria-controls="command-palette">
          {currentLocale === 'en' ? 'Commands' : 'Comandos'}
        </Button>
        <ThemeSwitch />
      </footer>
    </div>
    <div class="portrait">
      <Figure image={{ src: image, alt: name, width: 1024, height: 1024, loading: 'eager' }} />
    </div>
  </div>
</Section>

<style>
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;

    .portrait::before {
      content: "";
      display: block;
      width: 100%;
      height: 1px;
      background: var(--sua-border-strong);
      margin: 16px 0;
    }
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    justify-content: center;
  }

  .portrait :global(img) {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 128px;
    height: 128px;
    border-radius: var(--sua-radius-card);
  }

  .location {
    display: flex;
    align-items: center;
    gap: var(--sua-space-xs);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sua-space-xs);
    margin-top: 8px;
  }

  footer a {
    color: var(--sua-link);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--sua-border-control);
    padding: 4px;
    height: 2.75rem;
    width: 2.75rem;
    border-radius: var(--sua-radius-control);
    transition: background-color var(--sua-motion-duration) ease;
  }

  footer a:hover {
    background: var(--sua-surface);
    border-color: var(--sua-border-strong);
  }

  footer a:focus-visible {
    outline: var(--sua-focus-width) solid var(--sua-focus);
    outline-offset: var(--sua-focus-offset);
  }

  @media (forced-colors: active) {
    footer a {
      border-color: ButtonText;
    }

    footer a:focus-visible {
      outline-color: Highlight;
    }
  }

  @media print {
    .portrait,
    footer a,
    footer :global(.sua-button),
    footer :global(.theme-control) {
      display: none;
    }

    footer {
      margin-top: var(--sua-space-sm);
    }
  }

  @media (min-width: 940px) {
    .container {
      align-items: center;
      flex-direction: row;
      justify-content: space-between;
      gap: 1rem;

      .portrait::before {
        height: 0;
      }
    }

    .info {
      padding-right: 0;
      align-items: start;
    }
  }
</style>
