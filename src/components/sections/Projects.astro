---
import Section from "@/components/Section.astro";
import { ProjectShowcaseCard } from 'suabochica-design-system';

import { getI18N } from "@/i18n";
import { useTranslations, getLangFromUrl } from "i18n/utils";

const language = getLangFromUrl(Astro.url);
const translate = useTranslations(language);

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const { projects } = i18n;
---

<Section title={translate(".projects")}>
  <p class="introduction" set:html={translate(".projects.description")} />
  <ul>
    {
      projects.map(({ url, description, highlights, name, isActive }) => {
        return (
          <li>
            <ProjectShowcaseCard
              title={name}
              headingLevel={3}
              summary={description}
              link={{ href: url, target: '_blank', rel: 'noopener noreferrer' }}
              actionLabel={currentLocale === 'en' ? 'View project' : 'Ver proyecto'}
              metadata={isActive ? [{ key: 'status', content: currentLocale === 'en' ? 'Active project' : 'Proyecto activo' }] : []}
              metadataLabel={currentLocale === 'en' ? 'Status' : 'Estado'}
              tags={highlights.map((highlight, index) => ({ key: `${index}-${highlight}`, label: highlight }))}
              tagsLabel={currentLocale === 'en' ? 'Highlights' : 'Aspectos destacados'}
            />
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  .introduction {
    margin-bottom: var(--sua-space-lg);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--sua-space-lg);
  }

  li {
    min-width: 0;
  }
</style>
